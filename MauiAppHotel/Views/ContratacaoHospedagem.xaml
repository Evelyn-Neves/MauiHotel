<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <ScrollView> <!-- Serve para rolagem da página -->
        <VerticalStackLayout>
            <VerticalStackLayout.Resources>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="White"/>
                    </Style>
           </VerticalStackLayout.Resources>
                <VerticalStackLayout>
                    <Label Text="Hotel Miragem Azul"
                       FontSize="50"
                       FontFamily="Water font"
                       TextColor="#4357CC"
                       Margin="10"/>

                    <Label 
                    Text="Cálculo da Diária"
                    FontFamily="Arial Narrow"
                    FontSize="25"
                    TextColor="#4357CC"
                    Grid.Row="0"
                    Margin="20, 0, 0, 30"/>

                </VerticalStackLayout>

                <!--Parte Principal-->
                <Border Padding="20"
                        Grid.Row="1"
                        Stroke="#4357CC"
                        BackgroundColor="Black"
                        WidthRequest="319"
                        HeightRequest="550"
                        StrokeShape="RoundRectangle 10"
                        Margin="0, 0, 0, 20">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.5"
                                Offset="1,1"
                                Radius="25"/>
                    </Border.Shadow>
                    <VerticalStackLayout>
                    <Grid RowDefinitions="Auto, Auto"
                              ColumnDefinitions="*,*,2*">

                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos: "
                                   Margin="5"/>

                        <Label Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Value}" 
                                   BindingContext="{x:Reference stp_Adultos}"/>

                        <Border Grid.Row="0" Grid.Column="2"
                                    BackgroundColor="#7D66F5"
                                    Padding="2"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center">
                            <Stepper Grid.Row="0" Grid.Column="2" 
                                     x:Name="stp_Adultos"
                                     Minimum="0"
                                     Maximum="10"
                                     Increment="1"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças: "
                                    Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Value}"
                                   BindingContext="{x:Reference stp_criancas}"/>
                        <Border Grid.Row="1" Grid.Column="2"
                                    BackgroundColor="#7D66F5" 
                                    StrokeShape="RoundRectangle 10" 
                                    Padding="2" 
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" 
                                    Margin="5">
                            <Stepper Grid.Row="1" Grid.Column="2"
                                         x:Name="stp_criancas"
                                         Minimum="0"
                                         Maximum="10"
                                         Increment="1"/>
                        </Border>
                    </Grid>
                    <Border>
                        <VerticalStackLayout>
                            <Label Text="Escolha sua Suíte" FontFamily="Arial Narrow" 
                                   TextColor="White"
                                   Margin="10"
                                   TextTransform="Uppercase"
                                   FontSize="20"/>
                            <Picker x:Name="pck_quarto"
                                    Title="Selecione sua Acomodação" TitleColor="Gray"
                                    ItemDisplayBinding="{Binding Descricao}"
                                    Margin="5"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="10"
                               Margin="10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Período da Estadia"
                                       FontSize="30"
                                       FontFamily="Arial Narrow"
                                       TextColor="#4357CC"/>
                                <HorizontalStackLayout>
                                    <Label Text="Check-in:"
                                           Margin="10"/>
                                <DatePicker x:Name="dtpck_checkin"
                                            Format="dd/MM/yyyy" 
                                            TextColor="White"
                                            DateSelected="dtpck_checkin_DateSelected"/>
                            </HorizontalStackLayout>

                                <HorizontalStackLayout>
                                    <Label Text="Check-out:"
                                           Margin="10"/>
                                    <DatePicker x:Name="dtpck_checkout"
                                                Format="dd/MM/yyyy" TextColor="White"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!--Botão para ir para a próxima página-->
                        <Button Text="Avançar" BackgroundColor="#4357CC"
                                Clicked="Button_Avancar_Clicked"
                                Margin="0, 20"/>

                        <!-- Rodapé e Botão para ir para a página de sobre -->
                        <Label Text="Projeto Acadêmico - NET MAUI"
                               TextColor="White"/>
                        <Label Text="Desenvolvido por Evelyn © 2026"
                            TextColor="White"/>
                        <Button Text="Sobre"
                                Clicked="Button_Sobre_Clicked"
                                Background="Transparent"
                                TextColor="#4357CC"/>
                    </VerticalStackLayout>
                </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>