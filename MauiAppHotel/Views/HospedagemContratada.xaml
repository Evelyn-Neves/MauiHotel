<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Hospedagem Contratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <VerticalStackLayout
        VerticalOptions="Center">
        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="Black"
                WidthRequest="360"
                HeightRequest="290">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="1,1"
                        Opacity="0.5"
                        Radius="25"/>
            </Border.Shadow>

            <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                <VerticalStackLayout.Resources>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="White"/>
                    </Style>
                </VerticalStackLayout.Resources>

                <Label Text="{Binding QuartoSelecionado.Descricao}"
                       TextColor="#7D66F5"
                       FontFamily="Arial Narrow"
                       FontSize="45"
                       HorizontalTextAlignment="Center"/>

                <Border Margin="10">
                    <StackLayout Orientation="Horizontal">
                        <HorizontalStackLayout>
                            <!-- Adultos -->
                            <Label Text="Adultos: " Margin="10,15"/>
                            <Label Text="{Binding QntAdultos}" TextColor="#7D66F5" Margin="10,15"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <!-- Crianças -->
                            <Label Text="Crianças: " Margin="10,15"/>
                            <Label Text="{Binding QntCriancas}" TextColor="#7D66F5" Margin="10,15"/>
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>

                <Border Margin="10"
                        VerticalOptions="Center">
                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in: "
                               Margin="10"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="Check-out: "
                               Margin="0,10"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="Estadia: "
                               Margin="0,10"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckin, StringFormat = '{0:dd/MM/yyyy}'}"
                               Margin="10,5"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckout, StringFormat = '{0:dd/MM/yyyy}'}"
                               Margin="0,5"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}"
                               Margin="10,5"/>
                    </Grid>
                </Border>

                <Border Margin="10">
                    <HorizontalStackLayout>
                        <Label Text="Valor Total: "
                               Margin="10"/>
                        <Label Text="{Binding ValorTotal, StringFormat= '{0:c}'}" TextColor="#7D66F5" Margin="10"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar" Clicked="Button_Voltar_Clicked" Margin="20"/>
    </VerticalStackLayout>
</ContentPage>