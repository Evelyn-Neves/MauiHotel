<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Hospedagem Contratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <VerticalStackLayout>
        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="Black"
                WidthRequest="360"
                HeightRequest="290">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="1,1"
                        Opacity="0.5"
                        Radius="25"/>
            </Border.Shadow>

            <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                <VerticalStackLayout.Resources>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="White"/>
                    </Style>
                </VerticalStackLayout.Resources>

                <Label Text="Suíte Single"
                       TextColor="#7D66F5"
                       FontFamily="Arial Narrow"
                       FontSize="45"
                       HorizontalTextAlignment="Center"/>

                <Border Margin="10">
                    <HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <!-- Adultos -->
                            <Label Text="Adultos: " Margin="10"/>
                            <Label Text="2" TextColor="#7D66F5" Margin="0,10"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <!-- Crianças -->
                            <Label Text="Crianças: " Margin="15,10,10,10"/>
                            <Label Text="1" TextColor="#7D66F5" Margin="0,10"/>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Border Margin="10">
                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in: "/>
                        <Label Grid.Row="0" Grid.Column="1" Text="Check-out: "/>
                        <Label Grid.Row="0" Grid.Column="2" Text="Estadia: "/>

                        <Label Grid.Row="1" Grid.Column="0" Text="30/12/2026"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="30/12/2026"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="1 mês"/>
                    </Grid>
                </Border>

                <Border Margin="10">
                    <HorizontalStackLayout>
                        <Label Text="Valor Total: "/>
                        <Label Text="30 reais" TextColor="#7D66F5" Margin="10,0,0,0"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar" Clicked="Button_Voltar_Clicked" Margin="20"/>
    </VerticalStackLayout>
</ContentPage>